{
  "name": "chainbrowser-ext",
  "private": false,
  "version": "0.1.0",
  "description": "A Web3 browser extension focused on Stellar and blockchain networks",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "test": "vitest --passWithNoTests",
    "test:watch": "vitest --watch --passWithNoTests",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^13.0.0",
    "lucide-react": "^0.469.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.1.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.33",
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/chrome": "^0.0.299",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^3.0.4",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.9",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^3.0.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/chainbrowser.git"
  },
  "keywords": [
    "stellar",
    "blockchain",
    "web3",
    "browser-extension",
    "wallet",
    "cryptocurrency",
    "soroban",
    "defi"
  ],
  "author": "ChainBrowser Contributors",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/your-org/chainbrowser/issues"
  },
  "homepage": "https://github.com/your-org/chainbrowser#readme"
}
